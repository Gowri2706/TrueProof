    <!-- Terms of Service -->
    <string name="terms_intro">ட்ரூ ஷாட் AI செயலியைப் பயன்படுத்துவதன் மூலம், கீழே குறிப்பிடப்பட்டுள்ள சேவை விதிமுறைகளை நீங்கள் ஏற்றுக்கொள்கிறீர்கள்.</string>

    <string name="terms_using_title">செயலியைப் பயன்படுத்துதல்</string>
    <string name="terms_using_text">இந்த செயலியை சட்டப்பூர்வமான நோக்கங்களுக்காக மட்டுமே பயன்படுத்த வேண்டும். சேவையை தவறாகப் பயன்படுத்தவோ, பிறருக்கு தீங்கு விளைவிக்கும் நோக்கத்துடன் பயன்படுத்தவோ கூடாது.</string>

    <string name="terms_content_title">உங்கள் உள்ளடக்கம்</string>
    <string name="terms_content_text">நீங்கள் ஸ்கேன் செய்யும் புகைப்படங்கள் மற்றும் ஸ்கிரீன்ஷாட்களின் உரிமை உங்களிடமே இருக்கும். ஸ்கேன் முடிவுகளை வழங்குவதற்குத் தேவையான நோக்கங்களுக்காக மட்டுமே அவை பயன்படுத்தப்படும்.</string>

    <string name="terms_changes_title">விதிமுறைகளில் மாற்றங்கள்</string>
    <string name="terms_changes_text">இந்த சேவை விதிமுறைகளை தேவையான நேரங்களில் புதுப்பிக்கலாம். முக்கியமான மாற்றங்கள் செய்யப்பட்டால், செயலியின் மூலம் உங்களுக்கு தெரிவிக்கப்படும்.</string>

    <!-- Privacy Policy -->
    <string name="privacy_intro">உங்கள் தனிப்பட்ட தகவல் மற்றும் ஸ்கேன் செய்யப்படும் உள்ளடக்கத்தை எவ்வாறு கையாள்கிறோம் என்பதை இந்த தனியுரிமைக் கொள்கை விளக்குகிறது.</string>

    <string name="privacy_collect_title">நாங்கள் சேகரிக்கும் தகவல்கள்</string>
    <string name="privacy_collect_text">உங்கள் பெயர், மின்னஞ்சல் முகவரி மற்றும் நீங்கள் ஸ்கேன் செய்யும் புகைப்படங்கள் அல்லது ஸ்கிரீன்ஷாட்கள் போன்ற தகவல்கள் சேவையை வழங்குவதற்காக சேகரிக்கப்படலாம்.</string>

    <string name="privacy_use_title">தகவலை எவ்வாறு பயன்படுத்துகிறோம்</string>
    <string name="privacy_use_text">உங்கள் ஸ்கேன் முடிவுகளை வழங்கவும், உங்கள் ஸ்கேன் வரலாற்றை நிர்வகிக்கவும், செயலியின் சேவைகளை வழங்கவும் இந்த தகவல்கள் பயன்படுத்தப்படுகின்றன. உங்கள் தனிப்பட்ட தகவலை விற்பனை செய்வதில்லை.</string>

    <string name="privacy_choices_title">உங்கள் தேர்வுகள்</string>
    <string name="privacy_choices_text">உங்கள் ஸ்கேன் வரலாற்றை அழிக்கலாம் அல்லது தனியுரிமை மற்றும் பாதுகாப்பு அமைப்புகளில் இருந்து உங்கள் கணக்கை நீக்கலாம்.</string>

    <!-- Help & Support -->
    <string name="common_questions">பொதுவான கேள்விகள்</string>

    <string name="faq_how_scan">எப்படி ஸ்கேன் செய்வது?</string>
    <string name="faq_how_scan_answer">ஸ்கேன் பகுதியைத் திறந்து, கேமராவை பயன்படுத்தவும் அல்லது கேலரியில் இருந்து ஒரு புகைப்படத்தைத் தேர்ந்தெடுக்கவும். சில விநாடிகளில் முடிவு கிடைக்கும்.</string>

    <string name="faq_scan_fail">எனது ஸ்கேன் ஏன் தோல்வியடைந்தது?</string>
    <string name="faq_scan_fail_answer">புகைப்படம் தெளிவாகவும் போதுமான வெளிச்சத்துடனும் இருப்பதை உறுதி செய்யவும். இணைய இணைப்பும் இயக்கத்தில் இருக்க வேண்டும். பின்னர் மீண்டும் முயற்சிக்கவும்.</string>

    <string name="faq_old_scans">எனது பழைய ஸ்கேன்கள் எங்கே?</string>
    <string name="faq_old_scans_answer">ஒவ்வொரு ஸ்கேனும் History பகுதியில் சேமிக்கப்படும். மீண்டும் பார்க்க ஏதேனும் ஒன்றைத் தட்டவும்.</string>

    <string name="faq_delete_data">எனது தரவை எப்படி நீக்குவது?</string>
    <string name="faq_delete_data_answer">Profile → Privacy &amp; security பகுதிக்குச் செல்லவும். அங்கு உங்கள் ஸ்கேன் வரலாற்றை அழிக்கலாம் அல்லது கணக்கை நீக்கலாம்.</string>

