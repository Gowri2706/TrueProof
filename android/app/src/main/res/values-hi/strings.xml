    <!-- Terms of Service -->
    <string name="terms_intro">True Shot AI ऐप का उपयोग करके, आप नीचे दी गई सेवा की शर्तों को स्वीकार करते हैं।</string>

    <string name="terms_using_title">ऐप का उपयोग</string>
    <string name="terms_using_text">इस ऐप का उपयोग केवल कानूनी उद्देश्यों के लिए किया जाना चाहिए। सेवा का दुरुपयोग न करें और इसका उपयोग दूसरों को नुकसान पहुँचाने के उद्देश्य से न करें।</string>

    <string name="terms_content_title">आपकी सामग्री</string>
    <string name="terms_content_text">आपके द्वारा स्कैन की गई फ़ोटो और स्क्रीनशॉट का स्वामित्व आपके पास ही रहता है। इनका उपयोग केवल आपको स्कैन परिणाम प्रदान करने के आवश्यक उद्देश्य से किया जाता है।</string>

    <string name="terms_changes_title">शर्तों में बदलाव</string>
    <string name="terms_changes_text">हम आवश्यकता के अनुसार इन सेवा शर्तों को अपडेट कर सकते हैं। महत्वपूर्ण बदलाव होने पर आपको ऐप के माध्यम से सूचित किया जाएगा।</string>

    <!-- Privacy Policy -->
    <string name="privacy_intro">यह गोपनीयता नीति बताती है कि हम आपकी व्यक्तिगत जानकारी और आपके द्वारा स्कैन की गई सामग्री को कैसे संभालते हैं।</string>

    <string name="privacy_collect_title">हम कौन-सी जानकारी एकत्र करते हैं</string>
    <string name="privacy_collect_text">सेवा प्रदान करने के लिए आपका नाम, ईमेल पता और आपके द्वारा स्कैन की गई फ़ोटो या स्क्रीनशॉट जैसी जानकारी एकत्र की जा सकती है।</string>

    <string name="privacy_use_title">हम जानकारी का उपयोग कैसे करते हैं</string>
    <string name="privacy_use_text">इस जानकारी का उपयोग आपके स्कैन परिणाम दिखाने, आपके स्कैन इतिहास को प्रबंधित करने और ऐप की सेवाएँ प्रदान करने के लिए किया जाता है। हम आपकी व्यक्तिगत जानकारी बेचते नहीं हैं।</string>

    <string name="privacy_choices_title">आपके विकल्प</string>
    <string name="privacy_choices_text">आप अपना स्कैन इतिहास साफ़ कर सकते हैं या गोपनीयता और सुरक्षा सेटिंग्स से अपना खाता कभी भी हटा सकते हैं।</string>

    <!-- Help & Support -->
    <string name="common_questions">सामान्य प्रश्न</string>

    <string name="faq_how_scan">मैं स्कैन कैसे करूँ?</string>
    <string name="faq_how_scan_answer">स्कैन टैब खोलें, कैमरे से फोटो लें या गैलरी से फोटो चुनें। कुछ सेकंड में परिणाम दिखाई देगा।</string>

    <string name="faq_scan_fail">मेरा स्कैन क्यों विफल हुआ?</string>
    <string name="faq_scan_fail_answer">सुनिश्चित करें कि फोटो साफ और अच्छी रोशनी में है। आपका इंटरनेट कनेक्शन भी चालू होना चाहिए। फिर दोबारा प्रयास करें।</string>

    <string name="faq_old_scans">मेरे पुराने स्कैन कहाँ हैं?</string>
    <string name="faq_old_scans_answer">हर स्कैन History में सेव होता है। उसे दोबारा देखने के लिए किसी स्कैन पर टैप करें।</string>

    <string name="faq_delete_data">मैं अपना डेटा कैसे हटाऊँ?</string>
    <string name="faq_delete_data_answer">Profile → Privacy &amp; security पर जाएँ। वहाँ आप अपना स्कैन इतिहास साफ कर सकते हैं या अपना अकाउंट हटा सकते हैं।</string>

